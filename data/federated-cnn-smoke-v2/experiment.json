{
  "n_clients": 5,
  "rounds": 2,
  "clients_per_round": 5,
  "local_epochs": 1,
  "batch_size": 8,
  "learning_rate": 0.001,
  "seed": 42,
  "model": {
    "family": "character_cnn",
    "characters": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._~:/?#[]@!$&'()*+,;=%",
    "sequence_length": 32,
    "dropout_input": 0.1
  },
  "balancing": {
    "method": "undersampling",
    "adult_to_non_adult": "1:1",
    "seed": 42,
    "ensemble_members": 5,
    "k_neighbors": 5,
    "insufficient_minority": "adjust"
  },
  "aggregation_weight": "original_training",
  "threshold": 0.5,
  "evaluate_final_test": false
}

{
  "model_name": "character_cnn",
  "cnn_initialization": "stable_classifier_v1",
  "partition_type": "iid",
  "balancing_method": "undersampling",
  "training_protocol": "end_to_end",
  "n_clients": 5,
  "clients_per_round": 5,
  "rounds": 10,
  "local_epochs": 1,
  "batch_size": 64,
  "learning_rate": 0.001,
  "optimizer": {
    "name": "adamw",
    "weight_decay": 0.0
  },
  "sequence_length": 256,
  "seed": 42,
  "adult_to_non_adult": "1:1",
  "ensemble_members": 5,
  "smote_k_neighbors": 5,
  "smote_insufficient_minority": "adjust",
  "warmup_epochs": 1,
  "aggregation_weight": "original_training",
  "threshold": 0.5,
  "threshold_selection": {
    "source": "training_selection",
    "metric": "adult_f1",
    "bins": 201,
    "tie_break": "highest_threshold"
  },
  "evaluate_training": false,
  "evaluate_final_test": true,
  "pretrained_source": "data/pretrained/deberta-v3-base",
  "partition_root": null,
  "evaluation_population_id": null,
  "device": "cpu",
  "threads": 8,
  "generate_plots": true,
  "progress_interval_seconds": 30,
  "website_enrichment": null,
  "model_selection": {
    "source": "training_selection",
    "fraction": 0.1,
    "metric": "adult_f1"
  }
}
